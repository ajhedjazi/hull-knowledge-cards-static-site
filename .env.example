# Local default: ./data/hkc.sqlite
# Render persistent disk recommendation: /var/data/hkc.sqlite
DATABASE_PATH=./data/hkc.sqlite

# Used only by `npm run codes -- seed`; never expose this in VITE_* variables.
# Set this privately to the existing ten validation codes, comma-separated.
ACCESS_CODE_SEED=

# Render supplies PORT automatically.
PORT=3000
NODE_ENV=development
