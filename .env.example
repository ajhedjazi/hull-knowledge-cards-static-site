# Local default: ./data/hkc.sqlite
# Render persistent disk recommendation: /var/data/hkc.sqlite
DATABASE_PATH=./data/hkc.sqlite

# Existing paid single-use access codes; comma-separated.
# Never expose real codes in VITE_* variables or committed frontend source.
ACCESS_CODE_SEED=

# Reusable cohort access records; semicolon-separated if you add more than one.
# Format: CODE|cohort-key|source|ISO-expiry
# Example only: TRAINING-AUG26|aug-2026|training-provider|2026-09-30T23:59:59.000Z
# Future cohorts require configuration only, for example:
# TRAINING-SEP26|sep-2026|training-provider|2026-10-31T23:59:59.000Z
COHORT_ACCESS_SEED=

# Render supplies PORT automatically.
PORT=3000
NODE_ENV=development
